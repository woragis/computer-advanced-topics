# Copie para .env na raiz: cp .env.example .env
# Usado pelo docker compose para os serviços ai e api.

LLM_PROVIDER=anthropic
LLM_API_KEY=
FACT_CHECK_API_KEY=
SERPER_API_KEY=
MAIN_SERVER_SECRET=dev-shared-secret-change-me

# Modo mock no AI quando LLM_API_KEY estiver vazio (desenvolvimento sem custo)
AI_MOCK_LLM=true

# API — portal público (opcional; têm padrão no código)
# REANALYZE_COOLDOWN_HOURS=24
# DELETE_WINDOW_MINUTES=30
# PORTAL_PAGE_SIZE=20
